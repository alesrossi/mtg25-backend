# Copy to .env next to the compose files and fill in. Never commit .env.

# Required by both docker-compose.int.yml and docker-compose.server.yml
INT_POSTGRES_PASSWORD=change-me
# At least 32 characters, e.g. `openssl rand -base64 48`
INT_JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=

# docker-compose.server.yml only: public IP of the server (no domain)
SERVER_IP=

# docker-compose.int.yml only: Caddy basic auth for adminer.surveyl.top.
# Generate the hash with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpassword'
# Keep the single quotes: the bcrypt hash contains `$`, which compose would
# otherwise try to interpolate.
ADMINER_USER=admin
ADMINER_BASIC_AUTH_HASH='$2a$14$replace-with-generated-hash'

# Optional: frontend image tag (docker-compose.int.yml) and, for
# docker-compose.server.yml, the frontend repo path if not ../mtgfe25-frontend
# FRONTEND_TAG=latest
# FRONTEND_CONTEXT=../mtgfe25-frontend
